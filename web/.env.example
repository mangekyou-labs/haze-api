# Base Sepolia web environment.
# Copy to `.env.local` and fill in only the values needed for the environment.

# NextAuth / GitHub OAuth
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe is the only customer-facing payment rail.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Internal Base/x402 gateway integration.
GATEWAY_URL=http://localhost:3001
BILLING_INTERNAL_TOKEN=replace-with-a-random-server-token

# Public gateway URL used in generated client snippets.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# Optional error monitoring. Prompt, response, proof, secret, and spend
# identifiers are scrubbed before any event reaches the provider.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_RELEASE_SHA=
