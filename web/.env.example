# ─── Web app environment (stellar-launch) ─────────────────────────────
# Copy to .env.local and fill in. `next start` (production mode) REQUIRES
# AUTH_SECRET — without it next-auth v5 throws MissingSecret and every
# page 500s via the session endpoint. Generate: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth app (https://github.com/settings/developers). Without these
# the sign-in button is disabled and the page explains why.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe test mode (checkout + webhook relay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gateway integration (server-side)
GATEWAY_URL=http://localhost:3001
GATEWAY_SECRET=

# Public base URL shown in the dashboard API-key setup snippet
# (defaults to http://localhost:3001 when unset)
NEXT_PUBLIC_GATEWAY_URL=
