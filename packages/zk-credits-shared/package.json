{
  "name": "@zk-credits/shared",
  "version": "0.1.0",
  "description": "Isomorphic crypto + proof helpers shared by the zk-api-credits browser (web) and Node (gateway/CLI) runtimes.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./base": {
      "import": "./dist/base.js",
      "require": "./dist/base.js",
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    }
  },
  "files": ["dist", "src", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
