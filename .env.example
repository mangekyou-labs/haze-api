# ─── ZK API Credits — Environment Variables ─────────────────────
#
# This file documents every variable the gateway, fee-sponsor, and web app
# need. For local dev: copy to `.env` and fill in (gitignored).
#
# For Render (M3.2 + M3.4):
#   - Non-secret vars are committed in render.yaml.
#   - Secret vars are entered as Render environment variables — never commit
#     secret keys, Stripe/OAuth/OpenRouter creds, or DB URLs.
#
# For Vercel (M3.3):
#   - Set all env vars listed in web/vercel.json via the Vercel dashboard
#     (Settings → Environment Variables) or `vercel env add`.
#   - `NEXT_PUBLIC_*` vars are exposed to the browser; everything else is
#     server-only.
#
# ─── Stellar Testnet ────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Gateway account (holds USDC, creates deposits) — RENDER SECRET
GATEWAY_SECRET_KEY=<from: stellar keys show gateway>
GATEWAY_ADDRESS=<from: stellar keys address gateway>

# Demo user account (buys credits, calls API) — local/demo secret
DEMO_USER_SECRET_KEY=<from: stellar keys show demo-user>
DEMO_USER_ADDRESS=<from: stellar keys address demo-user>

# Deployed ZkCreditsContract on Soroban testnet (M3.1 confirm)
# — RENDER SECRET (also needed by fee-sponsor)
ZK_CONTRACT_ID=<from: stellar contract deploy or existing contract id>

# USDC testnet (Circle-issued SAC)
USDC_CONTRACT_ID=<deployed SAC contract ID on testnet>
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NOJ4VRAH3GJU3VC

# ─── Stripe (test mode) ─────────────────────────────────────────────
# VERCEL SECRET (web only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_5=price_test_...     # $5 credits
STRIPE_PRICE_20=price_test_...    # $20 credits
STRIPE_PRICE_50=price_test_...    # $50 credits

# ─── GitHub OAuth ───────────────────────────────────────────────────
# VERCEL SECRET (web only — the gateway doesn't serve OAuth)
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
NEXTAUTH_SECRET=<openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# ─── OpenRouter ────────────────────────────────────────────────────
# RENDER SECRET (gateway only)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Gateway Server ─────────────────────────────────────────────────
# PORT is set in render.yaml; DATABASE_URL comes from the Render database
PORT=3001
GATEWAY_BASE_URL=http://localhost:3001

# ─── Rate Limits ───────────────────────────────────────────────────
# Non-secret; committed in render.yaml
DEFAULT_EPOCH_QUOTA=100
PRICE_PER_CALL_USDC=1000          # 1000 base units = $0.001

# ─── PostgreSQL (durable storage; M2) ──────────────────────────────
# RENDER SECRET — DATABASE_URL is generated from the Render Postgres service.
# For local dev, provide either DATABASE_URL or the PG* composite vars.
# The gateway fails closed if neither DATABASE_URL nor PG* vars are set.
#
#   DATABASE_URL=postgres://user:pass@localhost:5432/zk_credits
# or the composite PG* vars:
#   PGHOST=localhost
#   PGPORT=5432
#   PGUSER=postgres
#   PGPASSWORD=...
#   PGDATABASE=zk_credits
#
# The gateway/billing/fee-sponsor schemas are created by ts/db/migrations.
# Local integration DB tests: RUN_DB_TESTS=1 with TEST_DATABASE_URL (default
# postgres://localhost:5432/zk_credits_test) and TEST_ADMIN_DATABASE_URL
# (default postgres://localhost:5432/postgres).

# ─── Spend worker (per-call on-chain settlement; M2.6) ─────────────
# Non-secret; committed in render.yaml
# The async spend() worker drains the durable settlement queue on this
# interval. Shorter intervals settle calls faster at the cost of more RPC
# traffic; leave unset for the 10s default.
# SPEND_WORKER_INTERVAL_MS=10000

# ─── Fee-sponsor service (public fee-relay; M2.4) ────────────────
# RENDER SECRET — fee-sponsor runs as a separate Render service.
#   ZK_CONTRACT_ID=<same contract as the gateway>
#   FEE_SPONSOR_SECRET_KEY=<sponsor XLM secret key (env-separated)>
# Non-secret; committed in render.yaml:
#   STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#   STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#   PORT=3002

# ─── Gateway withdrawal relay (M2.5) ──────────────────────────────
# The gateway's /v1/withdraw co-signs the withdraw tx and hands it to the
# fee-sponsor service for a fee bump; users never need XLM.
# RENDER config — set to the public URL of the deployed fee-sponsor.
FEE_SPONSOR_URL=http://localhost:3002
