# Base Sepolia / x402 zk-prepaid configuration.
# Copy to .env locally; never commit populated secrets.

# ─── Gateway ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
PUBLIC_GATEWAY_URL=http://localhost:3001
DATABASE_URL=postgres://postgres:zk_credits_dev@localhost:5432/zk_credits
OPENROUTER_API_KEY=sk-or-...

# ─── Service tokens ────────────────────────────────────────────────
# BILLING_INTERNAL_TOKEN guards invite redemption, the launch admin commands
# (status, pause, resume), and aggregate status. FACILITATOR_SERVICE_TOKEN
# guards the mutating facilitator endpoints. CLAIM_STORE_OPERATOR_TOKEN guards
# the operator-only dispatch-budget reset.
BILLING_INTERNAL_TOKEN=replace-with-a-random-server-token
FACILITATOR_SERVICE_TOKEN=replace-with-a-random-server-token
CLAIM_STORE_OPERATOR_TOKEN=replace-with-a-random-server-token

# ─── Pilot environment and launch controls ─────────────────────────
# PILOT_ENVIRONMENT is one of local, staging, or production. When it is unset it
# is derived from NODE_ENV: production becomes production, anything else local.
PILOT_ENVIRONMENT=local
#
# The kill switch and the provider-spend caps are durable Postgres state, not
# environment configuration. The single supported service class also fixes the
# model, the request limits, the price ceilings, and the per-dispatch spend
# ceiling, so none of those are tunable from the environment.
#
#   npm run launch:status
#   npm run launch:pause  -- --reason "provider incident"
#   npm run launch:resume
#
# The caps are $40 per UTC day and $200 per rolling 30 days.
#
# The two variables below are the single exception, and they are staging-only.
# They exist so the cap-exhaustion path can be exercised without spending real
# budget: a staging service narrows the ceiling and then trips it on purpose.
# They may only ever narrow it, and any deployment that is not explicitly
# staging refuses to start when either one is set, rather than silently ignoring
# it. A production service therefore cannot run on a staging cap.
#
# PILOT_STAGING_DAILY_CAP_MICRO_USD=
# PILOT_STAGING_ROLLING_CAP_MICRO_USD=

# ─── Base sponsor and immutable contract ───────────────────────────
BASE_RPC_URL=https://sepolia.base.org
BASE_PRIVATE_CREDIT_BOND_ADDRESS=0x0000000000000000000000000000000000000000
BASE_DEPLOYMENT_DOMAIN=84532
# The block the bond was deployed at. The event indexer starts here, so an
# unset value either scans the whole chain history or misses every
# BundleFunded event. `npm run activation:start` refuses a deployment whose
# indexed block has not reached this value.
BASE_DEPLOYMENT_BLOCK=
BASE_CONFIRMATIONS=3
BASE_SPONSOR_PRIVATE_KEY=0x...
BASE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
BASE_REFUND_VAULT=0x0000000000000000000000000000000000000000

# The gateway reads the generated Groth16 verification key only when this is
# configured. Missing or invalid verification material fails closed.
ZK_PREPAID_VERIFYING_KEY_PATH=/path/to/private_credit_spend/verification_key.json
ZK_PREPAID_CIRCUIT_ID=private-credit-spend-bn254-dev
ZK_PREPAID_VERIFYING_KEY_ID=private-credit-spend-vk-dev
ZK_PREPAID_REQUIREMENTS_VERSION=zk-prepaid-v1

# ─── GitHub OAuth / NextAuth (web only) ─────────────────────────────
# The unpaid pilot requires GitHub sign-in. The test-only development
# credential provider is enabled with ENABLE_DEV_LOGIN=1 and cannot bypass
# invite enforcement.
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000
GATEWAY_URL=http://localhost:3001

# Optional error monitoring. Prompt, response, proof, secret, and spend
# identifiers are scrubbed before any event reaches the provider.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ─── Local credential sidecar (developer machine only) ─────────────
ZK_CREDITS_CREDENTIAL_PATH=/path/to/credential.zkcred
ZK_CREDITS_CREDENTIAL_PASSWORD=use-a-local-password
ZK_CREDITS_ARTIFACT_DIR=/path/to/pinned-private-credit-bundle
ZK_CREDITS_WITNESS_PATH=/path/to/witness.json
ZK_CREDITS_GATEWAY_URL=http://localhost:3001
ZK_CREDITS_SIDECAR_PORT=3210
